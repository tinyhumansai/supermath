        "deny": [
          "wait",
          "wait_loop",
          "spawn_subagent",
          "spawn_async_subagent",
          "spawn_parallel_agents",
          "web_fetch",
          "shell"
        ]
      },
      "toolpacks": [
        "lean",
        "literature",
        "ledger"
      ]
    },
    {
      "id": "refuter",
      "role": "refuter",
      "prompt": "seats/refuter.md",
      "template": "openhuman",
      "config": {
        "action_dir": "{candidate}",
