# Build output
/target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Local state: the projects, caches and logs a host run of the toolkit keeps
.supermath/

# Loop folders `supermath-mcp loop new` writes: they name this machine's
# binary and env file. Only the statements they start from are committed.
loops/*
!loops/statements/

# Python bytecode from running the service tests locally.
__pycache__/
