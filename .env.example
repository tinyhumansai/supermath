# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crate, its tests, or compose read,
# with a placeholder value and a comment saying what it is for.

# --- Models: Surplus Intelligence -------------------------------------------

# Surplus Intelligence serves every chat completion and embedding, a loop's
# seats' (through rsi-ralph) and CortexDB's, called directly with concrete
# model names. compose refuses to start without it.
SURPLUS_API_KEY=replace-me
# Surplus's OpenAI-compatible API root.
# SURPLUS_URL=https://api.surplusintelligence.ai/v1

# --- CortexDB (compose service `cortexdb`) -----------------------------------

# The operator key; the ledger tools send it as a bearer token.
CORTEX_API_KEY=supermath-local
# CORTEX_API_URL=http://localhost:3141

# The scope subtree this deployment's memory hangs below. Two deployments
# sharing one server must set this differently.
# CORTEX_SCOPE_ROOT=ws:supermath

# The Surplus model CortexDB extracts, enriches and answers with.
# CORTEX_CHAT_MODEL=deepseek-v4.1-flash

# The Surplus embedding model CortexDB embeds with, and its width. CortexDB
# pins the width on first ingest, so changing either needs a fresh volume
# (compose names it after the model: `cortexdb-venice-embed-1`).
# SUPERMATH_EMBEDDING_MODEL=venice-embed-1
# SUPERMATH_EMBEDDING_DIMS=1024

# Root of the project workspaces: <root>/<slug>/{lean,python}. The file_*
# tools write here; the lean and python services run what was written.
# SUPERMATH_PROJECTS=./.supermath/projects

# One project directory to use instead of <SUPERMATH_PROJECTS>/<slug>, such as
# an rsi-ralph candidate checkout. `supermath-mcp --project-dir <dir>` sets it
# per command; leave it unset otherwise.
# SUPERMATH_PROJECT_DIR=

# --- rsi-ralph loops (docs/specs/loops.md) ------------------------------------

# The rsi-ralph run store. compose.rsi.yaml mounts it into the lean and python
# services, which then accept projects inside it. Default ~/.tinyrsi.
# TINYRSI_HOME=

# Where rsi-ralph's gateway sends model calls. A loop from `supermath-mcp loop
# new` reads its key from SURPLUS_API_KEY, so point this at Surplus:
# TINYRSI_UPSTREAM=https://api.surplusintelligence.ai/v1

# --- supermath-literature (crates/supermath-literature) ----------------------

# A contact address sent in the User-Agent of every arXiv, Semantic Scholar and
# OEIS request, as arXiv's API terms ask.
# SUPERMATH_CONTACT=you@example.org

# Optional Semantic Scholar key for lit_citations; without one the shared public
# rate limit applies.
# SEMANTIC_SCHOLAR_API_KEY=replace-me

# Directory for the on-disk response cache (stored under literature/). Unset
# disables caching.
# SUPERMATH_CACHE=.supermath/cache

# Base URLs, overridden only to point tests at a stub.
# SUPERMATH_ARXIV_API_URL=https://export.arxiv.org/api/query
# SUPERMATH_ARXIV_EPRINT_URL=https://arxiv.org/e-print
# SUPERMATH_SCHOLAR_URL=https://api.semanticscholar.org/graph/v1
# SUPERMATH_OEIS_URL=https://oeis.org/search

# Set to run the live arXiv test (live_literature_arxiv), which searches arXiv
# once: SUPERMATH_LIVE_ARXIV=1 cargo test -p supermath-literature --test live
# SUPERMATH_LIVE_ARXIV=

# --- supermath-web (crates/supermath-web) -------------------------------------

# Gemini API key for web_search and web_research (Google Search grounding).
# Empty means unset: both tools then answer BACKEND_UNAVAILABLE, and no other
# search engine stands in. web_read needs no key. Never commit a real value.
GEMINI_API_KEY=

# The pinned Gemini model name for the grounded turns.
# Google retires names; a 404 from Gemini means this one needs to move.
# SUPERMATH_WEB_MODEL=gemini-3.5-flash

# web_* calls allowed per project per UTC day.
# SUPERMATH_WEB_DAILY_CAP=200

# Responses are cached for 24 hours under $SUPERMATH_CACHE/web (SUPERMATH_CACHE
# and SUPERMATH_CONTACT, above, are shared with the literature tools; the
# contact goes into web_read's User-Agent).

# The Gemini API root, overridden only to point tests at a stub.
# SUPERMATH_WEB_BASE_URL=https://generativelanguage.googleapis.com

# Set (with GEMINI_API_KEY) to run the live Gemini test (live_web_search),
# which makes one grounded search:
# SUPERMATH_LIVE_WEB=1 cargo test -p supermath-web --test web live_web_search
# SUPERMATH_LIVE_WEB=

# --- Python solvers (compose service `python`) -------------------------------

# Where the pinned Python run service listens. Unset, py_run,
# py_search_counterexample and py_solvers answer BACKEND_UNAVAILABLE. The
# service sits on an internal network and publishes no port itself: start the
# opt-in gateway with `docker compose --profile host up` (PYTHON_PORT moves
# it off 3160) to reach it from the host.
# PYTHON_URL=http://localhost:3160
# PYTHON_PORT=3160

# The wall-clock timeout of a run that names none, and the longest it may ask,
# in seconds. The service enforces the cap too (SUPERMATH_PY_MAX_TIMEOUT).
# SUPERMATH_PY_DEFAULT_TIMEOUT=60
# SUPERMATH_PY_MAX_TIMEOUT=900

# The most values one py_search_counterexample may cover.
# SUPERMATH_PY_MAX_FRAME=100000000

# Per-run address-space limit (MiB), simultaneous runs, and the container's
# memory limit.
# SUPERMATH_PY_MEMORY_MB=4096
# SUPERMATH_PY_CONCURRENCY=2
# SUPERMATH_PY_MEM_LIMIT=8g

# Live tests (live_python_run, live_python_isolation) run when PYTHON_URL is
# set; SUPERMATH_PROJECTS must be the directory the service mounts at /projects.

# --- supermath-lean (compose service `lean`) ----------------------------------

# The Lean service. With it unset every lean_* tool that needs the service
# answers BACKEND_UNAVAILABLE. Inside compose the service is
# http://lean:3150; from the host, start the opt-in gateway
# (`docker compose --profile host up lean-gateway`) and use localhost.
# LEAN_URL=http://localhost:3150
# Host port the lean-gateway publishes on.
# LEAN_PORT=3150
# Warm REPLs in the service, and its memory ceiling.
# SUPERMATH_LEAN_POOL=2
# SUPERMATH_LEAN_MEM_LIMIT=12g

# lean_search's pattern and natural modes call hosted indexes directly from the
# toolkit (the Lean service has no network). Override only to point at a mirror.
# LOOGLE_URL=https://loogle.lean-lang.org/json
# LEANSEARCH_URL=https://leansearch.net/search

# --- supermath-mcp (crates/supermath-mcp) -------------------------------------

# `supermath-mcp serve [project]` and `check` read the union of the variables
# above: SUPERMATH_PROJECTS, LEAN_URL, PYTHON_URL, SUPERMATH_CONTACT,
# SEMANTIC_SCHOLAR_API_KEY, SUPERMATH_CACHE, GEMINI_API_KEY, CORTEX_API_URL,
# CORTEX_API_KEY and CORTEX_SCOPE_ROOT. A service whose variable is unset keeps
# its tools; they answer BACKEND_UNAVAILABLE. Inside compose the `mcp` profile
# uses LEAN_URL=http://lean:3150 and PYTHON_URL=http://python:3160.
