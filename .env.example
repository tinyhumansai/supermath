# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crate, its tests, or its examples
# read — including optional ones — with a placeholder value and a comment
# saying what it is for. `.env.example` is the contract; `.env` is the secret.

# Log filter for the `tracing`/`env_logger` style ecosystem.
# RUST_LOG=info

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1

# Example of a credential a live/network-gated test would need. Tests that
# require one must skip cleanly when it is unset.
# EXAMPLE_API_KEY=replace-me

# --- supermath-agent (crates/supermath-agent, compose.yaml) -----------------

# OpenAI-compatible API root for the solver's turns, and for CortexDB's
# embeddings and enrichment under docker compose. Defaults to OpenRouter.
# SUPERMATH_API_BASE_URL=https://openrouter.ai/api/v1

# Bearer token for that API. Required.
SUPERMATH_API_KEY=replace-me

# Model id sent with every solver request. Required. Under docker compose it is
# also CortexDB's extraction model unless CORTEX_CHAT_MODEL is set.
SUPERMATH_MODEL=replace-me

# OpenHuman backend URL. Unset keeps OpenHuman's default; the harness does not
# need a TinyHumans account when it uses the route above.
# SUPERMATH_BACKEND_URL=

# Where the OpenHuman workspace and agent home live. Defaults to ./.supermath.
# SUPERMATH_WORKSPACE=.supermath

# CortexDB address and operator key. The compose file runs the server and
# passes both; set them yourself only when running the binary on the host.
# CORTEX_API_URL=http://localhost:3141
CORTEX_API_KEY=supermath-local

# The scope subtree this deployment's memory hangs below. Two deployments
# sharing one server must set this differently.
# CORTEX_SCOPE_ROOT=ws:supermath

# CortexDB inference overrides (compose only). Default to the solver's key and
# model above.
# CORTEX_INFERENCE_KEY=
# CORTEX_CHAT_MODEL=
# CORTEX_EMBEDDING_MODEL=openai/text-embedding-3-small
# CORTEX_EMBEDDING_DIMS=1536

# Which file in problems/ `docker compose up` solves, without the `.md`.
# PROBLEM=sum-of-odd-numbers
