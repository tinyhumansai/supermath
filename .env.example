# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crate, its tests, or compose read,
# with a placeholder value and a comment saying what it is for.

# --- The LLM ladder (compose service `ladder`) -------------------------------

# The key every caller presents to the ladder. compose gives it to the ladder,
# CortexDB and the agent alike.
LADDER_API_KEY=replace-me

# Marketplace credentials the ladder routes with. A rung whose marketplace has
# no key is skipped. OPENROUTER_API_KEY is also the agent's Jev credential.
OPENROUTER_API_KEY=replace-me
SURPLUS_API_KEY=replace-me
# Venice serves the `vectors` (embeddings) ladder in the default config.
VENICE_INFERENCE_KEY=replace-me
# MISTRAL_API_KEY=

# The router config mounted into the ladder. Defaults to
# ~/.config/ladder/config.toml.
# LADDER_CONFIG_PATH=

# Host port the stack's ladder publishes on (6969 is left to a shared ladder).
# LADDER_PORT=6970

# --- supermath-agent (crates/supermath-agent) --------------------------------

# The ladder's API root. compose sets it to the `ladder` service.
# LADDER_URL=http://localhost:6970/v1

# The ladder the agent's turns run on, and how hard it thinks
# (none, minimal, low, medium, high, xhigh).
# SUPERMATH_MODEL=flash
# SUPERMATH_REASONING_EFFORT=medium

# The embeddings ladder and its width. CortexDB pins the width on first ingest,
# so changing it needs a fresh `cortexdb-data` volume.
# SUPERMATH_EMBEDDING_MODEL=vectors
# SUPERMATH_EMBEDDING_DIMS=1024

# Where the OpenHuman workspace and agent home live. Defaults to ./.supermath.
# SUPERMATH_WORKSPACE=.supermath

# OpenHuman backend URL. Unset keeps OpenHuman's default; the harness needs no
# TinyHumans account.
# SUPERMATH_BACKEND_URL=

# The project `docker compose up` checks; it names the agent and its memory.
# PROJECT=scratch

# --- CortexDB (compose service `cortexdb`) -----------------------------------

# The operator key; the agent sends it as a bearer token.
CORTEX_API_KEY=supermath-local
# CORTEX_API_URL=http://localhost:3141

# The scope subtree this deployment's memory hangs below. Two deployments
# sharing one server must set this differently.
# CORTEX_SCOPE_ROOT=ws:supermath

# The ladder CortexDB extracts and enriches with.
# CORTEX_CHAT_MODEL=flash

# Log filter for the `tracing` ecosystem; OpenHuman logs to
# $SUPERMATH_WORKSPACE/logs/.
# RUST_LOG=info
